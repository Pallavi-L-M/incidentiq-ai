# Hindsight Cloud (create a bank in your Cloud console; see README)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentiq-demo

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

PORT=3001

# Optional: the allowed frontend origin when Vite runs on a different port
APP_ORIGIN=http://localhost:5173

# Password reset email delivery via Resend
RESEND_API_KEY=
EMAIL_FROM=IncidentIQ <no-reply@example.com>
APP_URL=http://localhost:3001

# Optional persistent PostgreSQL via Supabase PostgREST (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
